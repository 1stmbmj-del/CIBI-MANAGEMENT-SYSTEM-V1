rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: userId (UID from Auth)
    // Fields:
    //   - fullName: string (required)
    //   - mobileNumber: string (required)
    //   - role: string (required, 'admin' or 'user')
    //   - photoURL: string (optional)
    //   - createdAt: string (required)
    //
    // Collection: admin_keys
    // Document ID: key string
    // Fields:
    //   - key: string (required)
    //   - used: bool (required)
    //   - createdBy: string (optional)
    //   - createdAt: string (required)
    //
    // Collection: assignments
    // Document ID: auto-generated
    // Fields:
    //   - borrowerName: string (required)
    //   - mobileNumber: string (required)
    //   - ciOfficerId: string (required)
    //   - status: string (required)
    //   - timeline: list (required)
    //   ... other fields
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailAdmin() {
      return isSignedIn() && 
             'email' in request.auth.token && 
             request.auth.token.email == "1stmb.mj@gmail.com";
    }

    function isDBAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             'role' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isAdmin() {
      return isEmailAdmin() || isDBAdmin();
    }

    function isCoordinator() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             'role' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "coordinator";
    }

    function isSupervisor() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             'role' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "supervisor";
    }

    function isManager() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             'role' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "manager";
    }

    function isPrivileged() {
      return isAdmin() || isCoordinator() || isSupervisor() || isManager();
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isValidAssignment(data) {
      return data.keys().hasAll(['borrowerName', 'mobileNumber', 'ciOfficerId', 'status', 'timeline']) &&
             data.borrowerName is string &&
             data.status is string &&
             data.timeline is list;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['userId', 'title', 'message', 'type', 'read', 'createdAt']) &&
             data.userId is string &&
             data.title is string && data.title.size() < 200 &&
             data.message is string && data.message.size() < 1000 &&
             data.type in ['info', 'assignment', 'status_change'] &&
             data.read is bool &&
             data.createdAt is string;
    }

    function isValidAttendance(data) {
      let requiredFields = ['userId', 'userName', 'date', 'status', 'createdAt'];
      return data.keys().hasAll(requiredFields) &&
             data.userId is string &&
             data.userName is string &&
             data.date is string &&
             data.status in ["ON TIME", "LATE", "UNDERTIME", "OVERTIME"] &&
             data.createdAt is string;
    }

    function isValidLeaveRequest(data) {
      let requiredFields = ['userId', 'userName', 'leaveType', 'startDate', 'endDate', 'reason', 'status', 'createdAt'];
      return data.keys().hasAll(requiredFields) &&
             data.userId is string &&
             data.userName is string &&
             data.leaveType is string &&
             data.startDate is string &&
             data.endDate is string &&
             data.reason is string &&
             data.status in ['Pending', 'Approved', 'Rejected'] &&
             data.createdAt is string;
    }

    function isValidOvertimeRequest(data) {
      let requiredFields = ['userId', 'userName', 'date', 'hours', 'minutes', 'reason', 'status', 'createdAt'];
      return data.keys().hasAll(requiredFields) &&
             data.userId is string &&
             data.userName is string &&
             data.date is string &&
             data.hours is number &&
             data.minutes is number &&
             data.reason is string &&
             data.status in ['Pending', 'Approved', 'Rejected'] &&
             data.createdAt is string;
    }

    function isValidOBRequest(data) {
      let requiredFields = ['userId', 'userName', 'startDate', 'endDate', 'reason', 'status', 'createdAt'];
      return data.keys().hasAll(requiredFields) &&
             data.userId is string &&
             data.userName is string &&
             data.startDate is string &&
             data.endDate is string &&
             data.reason is string &&
             data.status in ['Pending', 'Approved', 'Rejected'] &&
             data.createdAt is string;
    }

    function isValidAppraisalReport(data) {
      let requiredFields = ['userId', 'appraiserName', 'title', 'reportType', 'borrowerName', 'marketValue', 'recommendedLoan', 'data', 'createdAt'];
      return data.keys().hasAll(requiredFields) &&
             data.userId is string &&
             data.appraiserName is string &&
             data.title is string &&
             data.reportType in ['real_property', 'vehicle'] &&
             data.borrowerName is string &&
             (data.marketValue is number || data.marketValue is int) &&
             (data.recommendedLoan is number || data.recommendedLoan is int) &&
             data.createdAt is string;
    }

    function isValidStarAward(data) {
      let requiredFields = ['ciOfficerId', 'ciOfficerName', 'stars', 'accomplishment', 'month', 'year', 'dateAssigned', 'awardedBy', 'awardedById', 'createdAt'];
      return data.keys().hasAll(requiredFields) &&
             data.ciOfficerId is string &&
             data.ciOfficerName is string &&
             (data.stars is number || data.stars is int) &&
             data.accomplishment is string &&
             (data.month is number || data.month is int) &&
             (data.year is number || data.year is int) &&
             data.dateAssigned is string &&
             data.awardedBy is string &&
             data.awardedById is string &&
             data.createdAt is string;
    }

    // ===============================================================
        function isValidDelinquency(data) {
      let requiredFields = ['entryDate', 'name', 'address', 'loanAmount', 'principalBalance', 'interestBalance', 'penalty', 'pdi', 'totalBalance', 'createdAt'];
      return data.keys().hasAll(requiredFields) &&
             data.entryDate is string &&
             data.name is string &&
             data.address is string &&
             (data.loanAmount is number || data.loanAmount is int) &&
             (data.principalBalance is number || data.principalBalance is int) &&
             (data.interestBalance is number || data.interestBalance is int) &&
             (data.penalty is number || data.penalty is int) &&
             (data.pdi is number || data.pdi is int) &&
             (data.totalBalance is number || data.totalBalance is int) &&
             data.createdAt is string;
    }

    function isValidSuggestion(data) {
      let requiredFields = ['category', 'subject', 'message', 'isAnonymous', 'submittedBy', 'submittedByName', 'submittedByRole', 'status', 'createdAt', 'updatedAt'];
      let allowedFields = ['category', 'subject', 'message', 'isAnonymous', 'submittedBy', 'submittedByName', 'submittedByRole', 'status', 'reviewNote', 'resolvedBy', 'resolvedByName', 'resolvedAt', 'archivedBy', 'archivedByName', 'archivedAt', 'createdAt', 'updatedAt'];
      return data.keys().hasAll(requiredFields) &&
             data.keys().hasOnly(allowedFields) &&
             data.category in ['Idea', 'Comment', 'Office Problem'] &&
             data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 200 &&
             data.message is string && data.message.size() >= 1 && data.message.size() <= 5000 &&
             data.isAnonymous is bool &&
             data.submittedBy is string && data.submittedBy.size() >= 1 && data.submittedBy.size() <= 128 &&
             data.submittedByName is string && data.submittedByName.size() >= 1 && data.submittedByName.size() <= 150 &&
             data.submittedByRole is string && data.submittedByRole.size() >= 1 && data.submittedByRole.size() <= 50 &&
             data.status in ['Pending', 'Resolved', 'Archived'] &&
             (!('reviewNote' in data) || (data.reviewNote is string && data.reviewNote.size() <= 3000)) &&
             (!('resolvedBy' in data) || data.resolvedBy == null || (data.resolvedBy is string && data.resolvedBy.size() <= 128)) &&
             (!('resolvedByName' in data) || data.resolvedByName == null || (data.resolvedByName is string && data.resolvedByName.size() <= 150)) &&
             (!('resolvedAt' in data) || data.resolvedAt == null || (data.resolvedAt is string && data.resolvedAt.size() <= 64)) &&
             (!('archivedBy' in data) || data.archivedBy == null || (data.archivedBy is string && data.archivedBy.size() <= 128)) &&
             (!('archivedByName' in data) || data.archivedByName == null || (data.archivedByName is string && data.archivedByName.size() <= 150)) &&
             (!('archivedAt' in data) || data.archivedAt == null || (data.archivedAt is string && data.archivedAt.size() <= 64)) &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             data.updatedAt is string && data.updatedAt.size() <= 64;
    }
    // Rules
    // ===============================================================

    match /ci_star_awards/{awardId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn();
      allow create: if isSignedIn() && isValidStarAward(request.resource.data);
      allow update: if isSignedIn() && isValidStarAward(request.resource.data);
      allow delete: if isSignedIn() && (isPrivileged() || resource.data.awardedById == request.auth.uid);
    }

    match /appraisal_reports/{reportId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn();
      allow create: if isSignedIn() && isValidAppraisalReport(request.resource.data);
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (isPrivileged() || resource.data.userId == request.auth.uid);
    }

    match /appraisals/{appraisalId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn();
      allow create: if isSignedIn() && isValidAppraisalReport(request.resource.data);
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (isPrivileged() || resource.data.userId == request.auth.uid);
    }

    match /attendance/{attendanceId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn();
      allow create: if isSignedIn() && isValidAttendance(request.resource.data) && (request.resource.data.userId == request.auth.uid || isPrivileged());
      allow update: if isSignedIn() && (isPrivileged() || resource.data.userId == request.auth.uid) && isValidAttendance(request.resource.data);
      allow delete: if isAdmin();
    }

    match /leaves/{leaveId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn();
      allow create: if isSignedIn() && isValidLeaveRequest(request.resource.data) && (request.resource.data.userId == request.auth.uid || isPrivileged());
      allow update: if isSignedIn() && (isPrivileged() || resource.data.userId == request.auth.uid) && isValidLeaveRequest(request.resource.data);
      allow delete: if isAdmin();
    }

    match /overtime/{overtimeId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn();
      allow create: if isSignedIn() && isValidOvertimeRequest(request.resource.data) && (request.resource.data.userId == request.auth.uid || isPrivileged());
      allow update: if isSignedIn() && (isPrivileged() || resource.data.userId == request.auth.uid) && isValidOvertimeRequest(request.resource.data);
      allow delete: if isAdmin();
    }

    match /ob_requests/{obId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn();
      allow create: if isSignedIn() && isValidOBRequest(request.resource.data) && (request.resource.data.userId == request.auth.uid || isPrivileged());
      allow update: if isSignedIn() && (isPrivileged() || resource.data.userId == request.auth.uid) && isValidOBRequest(request.resource.data);
      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      // Use resource.data check for list since it's the recipient
      allow list: if isSignedIn();
      allow get: if isSignedIn();
      allow create: if isSignedIn() && isValidNotification(request.resource.data);
      allow update: if isSignedIn() && isOwner(resource.data.userId) && 
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if (isOwner(resource.data.userId) || isPrivileged()) && isSignedIn();
    }

    match /scoringConfigs/{configId} {
      allow read: if isSignedIn();
      allow write: if isPrivileged();
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin()) &&
                    (isAdmin() || request.resource.data.get('role', 'user') == resource.data.get('role', 'user'));
      allow delete: if isAdmin();
    }

    match /admin_keys/{keyId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isSignedIn() && (
        isAdmin() || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedBy', 'usedAt']) && 
          request.resource.data.used == true
        )
      );
      allow delete: if isAdmin();
    }

    match /assignments/{assignmentId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn();
      allow create: if isSignedIn() && isValidAssignment(request.resource.data);
      allow update: if isSignedIn() && isValidAssignment(request.resource.data);
      allow delete: if isAdmin();
    }

    match /evaluations/{evaluationId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn();
      allow create: if isSignedIn() && (isPrivileged() || request.resource.data.employeeId == request.auth.uid);
      allow update: if isSignedIn() && isPrivileged();
      allow delete: if isAdmin();
    }

    match /delinquencies/{delinquencyId} {
      // Admin, Supervisor, Manager, Coordinator, and CI officers can read
      allow list: if isSignedIn();
      allow get: if isSignedIn();
      // Admin, supervisor, manager and coordinator can create
      allow create: if isSignedIn() && (isPrivileged()) && isValidDelinquency(request.resource.data);
      // All authenticated users can update (add communication remarks, toggle progress, or edit)
      allow update: if isSignedIn() && isValidDelinquency(request.resource.data);
      // Admin can delete
      allow delete: if isAdmin();
    }

    match /suggestions/{suggestionId} {
      // Only Admin and Manager can read or list Suggestion Box entries
      allow list: if isAdmin() || isManager();
      allow get: if isValidId(suggestionId) && (isAdmin() || isManager());
      // Any authenticated user can drop an idea, comment, or office-related problem
      allow create: if isSignedIn() &&
                    isValidId(suggestionId) &&
                    isValidSuggestion(request.resource.data) &&
                    request.resource.data.submittedBy == request.auth.uid &&
                    request.resource.data.status == 'Pending';
      // Only Admin and Manager can mark as Resolved, Archive, or update review notes
      allow update: if isValidId(suggestionId) &&
                    (isAdmin() || isManager()) &&
                    isValidSuggestion(request.resource.data) &&
                    request.resource.data.submittedBy == resource.data.submittedBy &&
                    request.resource.data.createdAt == resource.data.createdAt &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewNote', 'resolvedBy', 'resolvedByName', 'resolvedAt', 'archivedBy', 'archivedByName', 'archivedAt', 'updatedAt']);
      allow delete: if isValidId(suggestionId) && isAdmin();
    }

  }
}
